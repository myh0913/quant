# 调度器镜像：quant-system 全量数据管道（竞价 / 盘中 / 盘后 / 复盘）。
# 注意：quant-system 不 pip install 进 site-packages —— config.py 的
# PROJECT_ROOT 按 __file__ 定位数据目录，装进 site-packages 会让
# data_dir 漂移到 /usr/local/lib；一律 PYTHONPATH 挂源码运行。
FROM python:3.12-slim

ENV TZ=Asia/Shanghai \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/quant-system/src

# tzdata：zoneinfo(Asia/Shanghai) 与 cron 式调度都依赖系统时区库
RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/quant-system

# 先只拷 pyproject 声明依赖（利用层缓存：改 src 不重装依赖）
COPY quant-system/pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir \
    "pydantic>=2.5" "python-dotenv>=1.0" "requests>=2.31" "eltdx>=3.1.3"

COPY quant-system/src ./src

# 密钥经 compose env_file 注入进程环境（.env 不进镜像）；
# 数据目录 /app/quant-system/data 由 compose 挂共享卷
CMD ["python", "-m", "quant_system.scheduler"]
