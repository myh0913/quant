# 量化系统环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，不会进入版本库。
# 不要在聊天、日志、命令参数或文档中复述密钥。

# 同花顺金融数据服务（Financial API）—— 从 https://fuyao.aicubes.cn/admin 签发
HITHINK_FINANCE_API_KEY=

# 选股通新闻快讯接口请求头 x-ivanka-token（从 xuangutong 页面请求中获取）
XUANGUTONG_IVANKA_TOKEN=

# Telegram 输出目标
TELEGRAM_CHAT_ID=7646550994

# 数据目录（默认相对项目根，可用绝对路径覆盖）
QUANT_DATA_DIR=data
