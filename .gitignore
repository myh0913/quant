# =============================================================================
# quant 仓库根 .gitignore
#
# 原则：
#   - 忽略「可由代码/依赖重建」的产物（虚拟环境、node_modules、构建输出、缓存）
#   - 忽略「凭据与密钥」——绝不入库
#   - 忽略运行期落盘数据（quant-system/data/）——体积大且按天累积，
#     跨机迁移用压缩包/rsync，不要塞进 git 历史
# =============================================================================

# ---------------------------------------------------------------- Python
.venv/
venv/
venv-*/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 注：*.egg-info/ 在 quant-system/src/ 下已被跟踪，此处不忽略以免造成
#     "已跟踪却被忽略" 的困惑

# ---------------------------------------------------------------- Node
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# ---------------------------------------------------------------- 凭据与密钥
.env
.env.*
!.env.example
credentials.env
*.pem
*.key

# ---------------------------------------------------------------- 系统文件
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- 运行期落库/落盘数据（quant-web 后端）
# quant.db 为 SQLite 运行时落库；lianban_ladder/ 由调度器按交易日生成。
# 程序一写入就弄脏 git status，还会卡住后续 pull（T-0033，2026-09-28）
quant-web/backend/quant.db
quant-web/backend/quant.db-*
quant-web/backend/data/lianban_ladder/

# quant-system 手动备份目录（一次性产物）
quant-system/data.bak.*/

# ---------------------------------------------------------------- 运行日志
# 注：logs/ 下的日志已被跟踪（用于跨机排查），此处不忽略
*.pid
nohup.out
